    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.60.0",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
