<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Voice input: the hardened runtime keeps the microphone from an app
         that doesn't ask for it here, and macOS then never even asks. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Overview reads system-calendar events, never writes them. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Recording another app's audio (ScreenCaptureKit) needs no entitlement
         under the hardened runtime: Screen Recording is a privacy permission
         the person grants in System Settings, and the question only shows
         when Info.plist has NSScreenCaptureUsageDescription (scripts/
         bundle-macos.sh). Adding a screen-capture key here would not change
         that. The release workflow checks the plist key is in the bundle. -->
    <!-- Native passkeys (docs/ACCOUNTS.md › Where the ceremony runs): the
         relying party AuthenticationServices may use. This is a restricted
         entitlement: it needs Contents/embedded.provisionprofile, so
         scripts/bundle-macos.sh removes it when no profile is given. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>webcredentials:sync.kansoapp.app</string>
    </array>
</dict>
</plist>
