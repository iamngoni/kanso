{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanso-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Served only on the owner's domains; the old workers.dev address is off. sync.kansoapp.app is
  // the apps' default; kanso.antonlabs.cc, its first name, keeps answering the devices and links
  // that use it. share.kansoapp.app shows published notes (SHARE_ORIGIN).
  "routes": [
    { "pattern": "sync.kansoapp.app", "custom_domain": true },
    { "pattern": "share.kansoapp.app", "custom_domain": true },
    { "pattern": "kanso.antonlabs.cc", "custom_domain": true }
  ],
  // Metrics stay on. Workers Logs keeps only what the Worker itself logs (route names and error
  // codes): invocation logs, which would record every request's URL and metadata, and traces are
  // pinned off, so no dashboard default can turn them on. `wrangler tail` still shows requests
  // live to whoever runs it (DEPLOYED.md).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Purges, expired rate-limit rows and sessions, and R2 reconciliation (src/purge.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Write-free filters in front of D1: AUTH_LIMITER for /v2/auth/* and /v2/health, keyed by IP
  // group; SESSION_LIMITER for every session route, keyed by account ID (src/limits.ts).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    // Published notes: /v2/public/* and the viewer page /p/*, keyed by IP group (src/shares.ts).
    { "name": "PUBLIC_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanso-sync",
      "database_id": "d9b0a705-d37b-46c0-b8f5-6ceabfd976b8",
      "migrations_dir": "migrations"
    }
  ],
  // Shared notes (docs/ACCOUNTS.md › Collaboration): one NoteRoom per note, keyed by share ID,
  // holding the note's log in its own SQLite storage and its members' live WebSockets
  // (src/room.ts). Reachable only through the Worker. The v1 migration creates the class with
  // SQLite storage; D1's 0005_collab.sql must be applied (npm run migrate:remote) before deploying.
  // Device approval: one AccountRoom per account, keyed by account ID, holding its devices'
  // hibernating event sockets and the alarm that sends its pushes (src/account_room.ts). It keeps
  // one value (the account ID), so the v2 migration creates it without SQLite; alarms work there.
  // v1 is deployed: append, never renumber.
  "durable_objects": {
    "bindings": [
      { "name": "NOTE_ROOM", "class_name": "NoteRoom" },
      { "name": "ACCOUNT_ROOM", "class_name": "AccountRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NoteRoom"] },
    { "tag": "v2", "new_classes": ["AccountRoom"] }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kanso-files"
    }
  ],
  // Kanso's link-preview image, /og/kanso.png (assets/icon/make-og.swift draws it). Only paths
  // that are files here are served as assets; every other request reaches the Worker.
  "assets": { "directory": "./public" },
  // Published notes' short links (src/rerout.ts): the Rerout project REROUT_API_KEY belongs to.
  // The key is a secret, `wrangler secret put REROUT_API_KEY`; without it there are no short links.
  // REROUT_DOMAIN: the project's custom domain links are made on (added and verified in Rerout,
  // with go.kansoapp.app's CNAME in the kansoapp.app zone).
  // SHARE_ORIGIN: where short links lead, so a published note is read on share.kansoapp.app
  // whichever name the app published it through.
  // Push notifications (src/push.ts): APNS_TOPIC is the app's bundle ID. The secrets go through
  // `wrangler secret put APNS_KEY_P8` (the .p8 file's PEM), `APNS_KEY_ID`, `APNS_TEAM_ID` and
  // `FCM_SERVICE_ACCOUNT` (the service account's JSON key). A platform without its secrets stores
  // its devices' tokens and sends nothing.
  // Sign-in (step 7, on since 2026-10-25). Secrets go through `wrangler secret put NAME`:
  // APPLE_PRIVATE_KEY and GOOGLE_CLIENT_SECRET. GOOGLE_CLIENT_ID is the Desktop client in Google
  // Cloud project kanso-512706; GITHUB_CLIENT_ID is the device-flow OAuth app (no secret).
  "vars": {
    "REROUT_PROJECT_ID": "prj_xX6I1BVjuNKzdE0o",
    "REROUT_DOMAIN": "go.kansoapp.app",
    "SHARE_ORIGIN": "https://share.kansoapp.app",
    "GOOGLE_CLIENT_ID": "1051829033489-h47joj5qmh7bthtbtnesl96eced84s1m.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23li1Yf81hocEW3k0d",
    "PASSKEY_RP_ID": "sync.kansoapp.app",
    "PASSKEY_ORIGINS": "[\"https://sync.kansoapp.app\"]",
    "APP_ASSOC_APPS": "[\"4973Y692JU.app.kanso.Kanso\", \"4973Y692JU.app.kanso.Kanso.dev\"]",
    "APPLE_CLIENT_ID": "app.kanso.Kanso.web",
    "APPLE_TEAM_ID": "4973Y692JU",
    "APPLE_KEY_ID": "MS6Y3S5ZL7",
    "APPLE_REDIRECT_URI": "https://sync.kansoapp.app/v2/auth/apple/callback",
    "APNS_TOPIC": "app.kanso.Kanso",
    // Usage counts (docs/METRICS.md, src/metrics.ts) go to PostHog's EU host. The project's API
    // key is a secret, `wrangler secret put POSTHOG_KEY`; without it batches are checked and
    // nothing is sent.
    "POSTHOG_HOST": "https://eu.i.posthog.com"
  }
  // AUTH_PEPPER (required) is a secret: `wrangler secret put AUTH_PEPPER` (reads stdin; see README.md).
  // SYNC_TOKEN is no longer read; `admin purge-legacy` deletes it.
}
